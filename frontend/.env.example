# Copie para .env.local e preencha localmente. Nunca commitar o .env.local real.

# URL base da API do backend (sem barra final), incluindo o context-path /api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Endereço público do catálogo, sem barra final. Em produção, o domínio real da loja —
# é ele que faz o preview do link no WhatsApp aparecer com imagem, e alimenta o sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp da vendedora, em formato internacional sem símbolos (ex.: 5581999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=5581988072670

# Contatos exibidos no rodapé (os mesmos da página de contato do catálogo impresso).
# Deixe em branco para ocultar a linha correspondente.
NEXT_PUBLIC_INSTAGRAM_HANDLE=frutodamalhabebe
NEXT_PUBLIC_EMAIL=frutodamalhavendas@gmail.com
NEXT_PUBLIC_TELEFONE=81 9 8807-2670
NEXT_PUBLIC_ENDERECO=Rua Severino Ramos Ferreira, 88 — B. São Cristóvão
Santa Cruz do Capibaribe - PE, CEP 55194-112
