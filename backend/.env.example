# Copie para .env e preencha localmente. Nunca commitar o .env real.
#
# O Spring Boot carrega este arquivo sozinho (spring.config.import em application.yml) — não é
# preciso instalar nada nem exportar variável nenhuma manualmente no terminal. Basta o arquivo
# .env existir na pasta backend/ (mesma pasta deste .env.example) antes de rodar a aplicação.
#
# EM PRODUÇÃO ESTE ARQUIVO NÃO EXISTE: as variáveis são configuradas no painel da Railway.
# Ver docs/DEPLOY.md para a lista de produção e os valores que cada uma recebe lá.

SPRING_PROFILES_ACTIVE=dev

# Banco de dados (dev local via Docker; em produção, a connection string da Neon com sslmode=require)
DB_URL=jdbc:postgresql://localhost:5432/frutodamalha
DB_USERNAME=frutodamalha
DB_PASSWORD=frutodamalha

# JWT — gere um segredo forte (>= 256 bits) para produção, ex.: openssl rand -base64 64
APP_JWT_SECRET=troque-este-valor-por-um-segredo-forte-de-pelo-menos-32-caracteres
APP_JWT_EXPIRATION_MS=86400000

# CORS — origem do frontend. Em produção, o domínio da Vercel; vírgula separa múltiplas origens.
# Nunca use "*": a aplicação recusa subir, porque a API usa credenciais (JWT).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=frutodamalha

PORT=8080

# ---------------------------------------------------------------------------------------------
# Primeiro administrador
# ---------------------------------------------------------------------------------------------
# Em desenvolvimento não é preciso mexer aqui: application-dev.yml já cria
# admin@frutodamalha.com.br / admin123 na primeira subida com o banco vazio.
#
# Em PRODUÇÃO estas variáveis são o único jeito de criar o primeiro acesso (não há tela de
# cadastro, por design). Ligue-as no painel da Railway apenas no primeiro deploy e REMOVA depois
# do primeiro login — elas guardam a senha em texto puro.
#
# A senha precisa ter no mínimo 12 caracteres fora do perfil dev; se for menor, a aplicação
# recusa subir de propósito, para não publicar um painel com senha fraca.
#
# APP_ADMIN_BOOTSTRAP_ENABLED=true
# APP_ADMIN_BOOTSTRAP_NOME=Administradora
# APP_ADMIN_BOOTSTRAP_EMAIL=
# APP_ADMIN_BOOTSTRAP_SENHA=
